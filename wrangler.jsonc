// The Tenwise website as a Cloudflare Worker that serves the static files in
// public/ (only that folder is published). It has no public address of its own: tenwise.app and www.tenwise.app
// belong to the platform's Worker (Tenwise/tenwise-platform,
// infrastructure/cloudflare), which signs people in and shows signed-out
// visitors this website through a service binding.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tenwise-website",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
